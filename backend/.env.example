# Satoshi Sentinel backend — placeholders only. Copy to .env and adjust.
# No AI key is required for the application to run: /api/ai/explain always
# falls back to a deterministic local explanation if AI_EXPLAIN_ENABLED is
# false or ANTHROPIC_API_KEY is empty.

APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call this API in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite by default — fine for a hackathon MVP. Swap for a Postgres URL
# later without changing any endpoint code beyond app/models/db.py.
DATABASE_URL=sqlite:///./satoshi_sentinel.db

# Public Bitcoin block explorer API used for read-only lookups. No key
# needed for mempool.space's public API.
BITCOIN_API_BASE_URL=https://mempool.space/api
BITCOIN_LOOKUP_TIMEOUT_SECONDS=5

# Public Nostr relays queried (read-only, anonymous) for profile lookups.
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
NOSTR_LOOKUP_TIMEOUT_SECONDS=5

# Optional. Leave both blank/false to run entirely on the local
# deterministic explanation template (the default and the hackathon-safe
# setting). Never commit a real key to source control.
ANTHROPIC_API_KEY=
AI_EXPLAIN_ENABLED=false
